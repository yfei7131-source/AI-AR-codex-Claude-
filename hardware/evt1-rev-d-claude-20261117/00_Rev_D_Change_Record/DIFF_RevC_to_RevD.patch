+def chk_aud03_timing():
+    # ASSUMPTIONS (not datasheet-verified here): AXC tpd <= 6 ns, FPC 0.25 m @ 6.5 ns/m, ESP32 slave tx <= 35 ns,
+    # nRF setup <= 20 ns, IM69D130 data-valid <= 90 ns, ESP32 PDM setup <= 15 ns.
