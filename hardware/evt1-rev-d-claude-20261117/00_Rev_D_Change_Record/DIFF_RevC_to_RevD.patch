+    d = c["divider_from_3v3"]; rt = d["r1_top_ohm"] + d["r2_mid_ohm"] + d["r3_bot_ohm"]
+    v_lo = 3.3 * d["r3_bot_ohm"] / rt; v_hi = 3.3 * (d["r2_mid_ohm"] + d["r3_bot_ohm"]) / rt
+    k = c["csa_gain_v_per_v"] * c["r_sense_high_side_ohm"]  # V per A
+    errs = []
