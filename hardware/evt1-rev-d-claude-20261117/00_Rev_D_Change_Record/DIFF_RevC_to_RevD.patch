+def max98357_window(v):
+    if v > 1.4: return "LEFT"
+    if 0.77 < v < 1.4: return "RIGHT"
+    if 0.16 < v < 0.77: return "MIX"
+    if v < 0.16: return "SHUTDOWN"
+    return "EDGE"
