+def chk_net07_fpga(D):
+    ports = re.findall(r"\b(?:input|output)\s+(?:wire|reg)\s*(?:\[\d+:\d+\])?\s*(\w+)", D["rtl"])
+    pcf = re.findall(r"^set_io\s+(\S+)\s+(\S+)", D["pcf"], re.M)
