+        return "FAIL", "; ".join(errs[:6])
+    return "PASS", f"J_BTB_L==J_BRIDGE_IN (32 contacts); all {len(conn['J_BTB_R'])} J_BTB_R contacts carried by trunk; every multi-board net crosses the correct connectors"
