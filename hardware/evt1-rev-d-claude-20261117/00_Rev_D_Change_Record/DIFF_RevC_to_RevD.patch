+    name2net = lambda p: {"cdone_vsync_n": "FPGA_CDONE_VSYNC_N"}.get(p, re.sub(r"\[(\d+)\]", r"\1", p))
+    fp = {r["Pin"]: r["Net"] for r in D["net"] if r["RefDes"] == "U2_FPGA"}
