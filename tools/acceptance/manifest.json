{
  "version": "sprint02-2-bidirectional",
  "source": "synthetic_fixture",
  "limitation": "程序生成的非敏感清晰图；不是自然场景、相机实拍、硬件或真实云端验收证据。",
  "samples": [
    {"id":"V01","kind":"vision","image":"V01.png","question":"请说明图中物体数量、颜色、形状和左右位置。不要猜测不可见内容。","expected":{"facts":["共2个图形","左侧红色圆形","右侧蓝色矩形"],"text":["A1","B2"]},"shapes":[{"shape":"circle","color":"red","box":[130,260,390,520],"label":"A1"},{"shape":"rectangle","color":"blue","box":[700,260,1040,520],"label":"B2"}]},
    {"id":"V02","kind":"vision","image":"V02.png","question":"请说明图中图形总数，以及上方、左下和右下的形状与颜色。","expected":{"facts":["共3个图形","上方橙色三角形","左下绿色圆形","右下紫色矩形"],"text":["TOP","LEFT","RIGHT"]},"shapes":[{"shape":"triangle","color":"orange","box":[460,170,740,400],"label":"TOP"},{"shape":"circle","color":"green","box":[180,450,400,670],"label":"LEFT"},{"shape":"rectangle","color":"purple","box":[800,450,1040,670],"label":"RIGHT"}]},
    {"id":"V03","kind":"vision","image":"V03.png","question":"请数出圆形数量、颜色，以及圆形下方从左到右的标识。","expected":{"facts":["共3个黄色圆形","从左到右标识为1、2、3"],"text":["1","2","3"]},"shapes":[{"shape":"circle","color":"yellow","box":[100,280,340,520],"label":"1"},{"shape":"circle","color":"yellow","box":[480,280,720,520],"label":"2"},{"shape":"circle","color":"yellow","box":[860,280,1100,520],"label":"3"}]},
    {"id":"V04","kind":"vision","image":"V04.png","question":"请描述中间图形以及上下两个图形的形状和颜色。","expected":{"facts":["中间蓝色圆形","上方和下方各一个绿色矩形","共3个图形"],"text":["UP","MID","DOWN"]},"shapes":[{"shape":"rectangle","color":"green","box":[390,170,810,270],"label":"UP"},{"shape":"circle","color":"blue","box":[490,340,710,560],"label":"MID"},{"shape":"rectangle","color":"green","box":[390,620,810,700],"label":"DOWN"}]},
    {"id":"V05","kind":"vision","image":"V05.png","question":"请按从左到右的顺序说明三个图形的颜色和形状。","expected":{"facts":["左侧红色三角形","中间蓝色圆形","右侧绿色矩形"],"text":["L","M","R"]},"shapes":[{"shape":"triangle","color":"red","box":[90,260,350,520],"label":"L"},{"shape":"circle","color":"blue","box":[470,260,730,520],"label":"M"},{"shape":"rectangle","color":"green","box":[860,260,1110,520],"label":"R"}]},
    {"id":"V06","kind":"vision","image":"V06.png","question":"请说明图形总数、红色图形的数量和中间图形的颜色形状。","expected":{"facts":["共3个图形","左右各一个红色圆形，共2个","中间黄色三角形"],"text":["A","B","C"]},"shapes":[{"shape":"circle","color":"red","box":[100,280,340,520],"label":"A"},{"shape":"triangle","color":"yellow","box":[470,260,730,520],"label":"B"},{"shape":"circle","color":"red","box":[860,280,1100,520],"label":"C"}]},
    {"id":"V07","kind":"vision","image":"V07.png","question":"请说明左右两个图形的颜色和形状，并读取下方标识。","expected":{"facts":["左侧紫色五边形","右侧橙色圆形"],"text":["P5","C1"]},"shapes":[{"shape":"pentagon","color":"purple","box":[160,250,440,530],"label":"P5"},{"shape":"circle","color":"orange","box":[760,250,1040,530],"label":"C1"}]},
    {"id":"V08","kind":"vision","image":"V08.png","question":"请数出图形数量、描述颜色和形状，并按顺序读取标识。","expected":{"facts":["一排4个蓝色正方形","从左到右为S1、S2、S3、S4"],"text":["S1","S2","S3","S4"]},"shapes":[{"shape":"rectangle","color":"blue","box":[90,300,270,480],"label":"S1"},{"shape":"rectangle","color":"blue","box":[370,300,550,480],"label":"S2"},{"shape":"rectangle","color":"blue","box":[650,300,830,480],"label":"S3"},{"shape":"rectangle","color":"blue","box":[930,300,1110,480],"label":"S4"}]},
    {"id":"V09","kind":"vision","image":"V09.png","question":"请说明左侧、右上、右下分别是什么颜色和形状。","expected":{"facts":["左侧绿色椭圆形","右上红色三角形","右下黄色矩形","共3个图形"],"text":["LEFT","TOP","BOTTOM"]},"shapes":[{"shape":"ellipse","color":"green","box":[100,330,490,550],"label":"LEFT"},{"shape":"triangle","color":"red","box":[760,170,1040,390],"label":"TOP"},{"shape":"rectangle","color":"yellow","box":[760,480,1040,660],"label":"BOTTOM"}]},
    {"id":"V10","kind":"vision","image":"V10.png","question":"请描述上下两个圆形的颜色，中间图形的颜色和形状。","expected":{"facts":["上方红色圆形","中间灰色矩形","下方蓝色圆形","共3个图形"],"text":["TOP","CENTER","BOTTOM"]},"shapes":[{"shape":"circle","color":"red","box":[510,140,690,320],"label":"TOP"},{"shape":"rectangle","color":"gray","box":[390,380,810,480],"label":"CENTER"},{"shape":"circle","color":"blue","box":[510,550,690,730],"label":"BOTTOM"}]},
    {"id":"T01","kind":"translate","image":"T01.png","source_language":"en","target_language":"zh-CN","question":"请逐行读取标签原文并翻译成简体中文，保留数字和单位。不清楚的内容明确说明。","expected":{"text":["KEEP DOOR CLOSED"],"translation_reference":["请保持门关闭"]}},
    {"id":"T02","kind":"translate","image":"T02.png","source_language":"en","target_language":"zh-CN","question":"请读取标签原文并翻译为简体中文，保留电压及单位。","expected":{"text":["INPUT: 5 V DC","MAX CURRENT: 2 A"],"translation_reference":["输入：直流5伏","最大电流：2安"]}},
    {"id":"T03","kind":"translate","image":"T03.png","source_language":"en","target_language":"zh-CN","question":"请逐行读取告示原文并翻译为简体中文。","expected":{"text":["NO ENTRY","AUTHORIZED PERSONNEL ONLY"],"translation_reference":["禁止进入","仅限授权人员"]}},
    {"id":"T04","kind":"translate","image":"T04.png","source_language":"en","target_language":"zh-CN","question":"请读取警示牌原文并翻译成简体中文。","expected":{"text":["CAUTION","HOT SURFACE"],"translation_reference":["注意","高温表面／表面烫手"]}},
    {"id":"T05","kind":"translate","image":"T05.png","source_language":"en","target_language":"zh-CN","question":"请读取货架标签并翻译为简体中文，准确保留字母和编号。","expected":{"text":["SHELF B","SLOT 03"],"translation_reference":["B货架","03号位"]}},
    {"id":"T06","kind":"translate","image":"T06.png","source_language":"zh-CN","target_language":"en","question":"请保留标签中文原文，并翻译成英文，准确保留交货日期。","expected":{"text":["交货日期","2026-11-20"],"translation_reference":["DELIVERY DATE","2026-11-20"]}},
    {"id":"T07","kind":"translate","image":"T07.png","source_language":"zh-CN","target_language":"en","question":"请保留电池标签中文原文，并翻译成英文，保留数字和单位。","expected":{"text":["电池：3.7 伏","容量：500 毫安时"],"translation_reference":["BATTERY: 3.7 V","CAPACITY: 500 mAh"]}},
    {"id":"T08","kind":"translate","image":"T08.png","source_language":"zh-CN","target_language":"en","question":"请保留状态提示中文原文，并翻译成英文。","expected":{"text":["电量低","请充电"],"translation_reference":["LOW BATTERY","PLEASE CHARGE"]}},
    {"id":"T09","kind":"translate","image":"T09.png","source_language":"zh-CN","target_language":"en","question":"请保留营业时间中文原文，并翻译成英文，保留全部时间。","expected":{"text":["营业时间 09:00 - 18:00","周一休息"],"translation_reference":["OPEN 09:00 - 18:00","CLOSED ON MONDAY"]}},
    {"id":"T10","kind":"translate","image":"T10.png","source_language":"zh-CN","target_language":"en","question":"请保留操作说明中文原文，并翻译成英文，保留操作先后顺序。","expected":{"text":["按下启动键","等待绿灯亮起"],"translation_reference":["PRESS START","WAIT FOR GREEN LIGHT"]}}
  ]
